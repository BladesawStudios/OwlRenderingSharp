<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>BladesawStudios</Authors>
    <Product>OwlRenderingSharp</Product>
    <RepositoryUrl>https://github.com/BladesawStudios/OwlRenderingSharp</RepositoryUrl>
  </PropertyGroup>

</Project>
