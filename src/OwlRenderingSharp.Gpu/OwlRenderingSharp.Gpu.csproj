<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The only project of OwlRenderingSharp that references OpenGL: the device, buffers, textures, framebuffers and programs.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OwlRenderingSharp.Core\OwlRenderingSharp.Core.csproj" />
    <ProjectReference Include="..\OwlRenderingSharp.Content\OwlRenderingSharp.Content.csproj" />
  </ItemGroup>

</Project>
